{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>claytono/renovate-config"],
  "customManagers": [
    {
      "description": "The Renovate image the job runs to find each repository's images",
      "customType": "regex",
      "managerFilePatterns": ["/^renovate_docker_datasource/discover\\.py$/"],
      "matchStrings": [
        "RENOVATE_IMAGE = \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge the Renovate image the job runs; CI's dry run checks that the job still works with it",
      "matchDepNames": ["ghcr.io/renovatebot/renovate"],
      "automerge": true
    }
  ]
}
